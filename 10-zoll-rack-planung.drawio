          <mxGeometry as="geometry" x="600" y="128" width="500" height="100" />
        </mxCell>
        <mxCell id="note2" value="Fachböden als Planungsmaße: A ca. 230 mm, B ca. 200 mm. Die genaue Einbautiefe und Kabelanschlüsse am aufgebauten Rack prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="248" width="500" height="115" />
        </mxCell>
        <mxCell id="note3" value="Bosch-Modell unbekannt. TaHoma nutzt WLAN; mit Ethernet-Adapter steigt der Portbedarf. Netzteile und Funkabstand bei der Montage prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="383" width="500" height="130" />
        </mxCell>
        <mxCell id="note4" value="Portbedarf: 2 × Hue + Bosch + Sonos + Uplink = 5. TaHoma mit optionalem Ethernet-Adapter = 6. 8 Ports reichen." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="533" width="500" height="87" />
        </mxCell>

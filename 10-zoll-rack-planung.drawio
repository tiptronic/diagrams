        <mxCell id="d-note" value="DP-0033: Stellfläche 216 × 100 mm, laut Hersteller Platz für Pi 4 und Pi 5 nebeneinander. Konkrete Kühler, Gehäuse und Steckerhöhe vor Montage prüfen. HE 1 darunter bleibt für Luft und Kabelzugang frei." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="520" y="765" width="560" height="115" />

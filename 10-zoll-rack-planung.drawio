        <mxCell id="rear-item7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" value="" vertex="1">
          <mxGeometry height="58" width="510" x="117" y="575" as="geometry" />
        </mxCell>
        <mxCell id="rear-note1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" value="Strom: 2 × Hue + Bosch + Green + Sonos + Pi 4 + Pi 5 + Switch = 8 Stecker für 8 Dosen, sofern jedes Gerät ein Einzelnetzteil hat. Pi 4: 5 V/3 A; Pi 5: 5 V/5 A empfohlen. Netzteilbreite und Steckerfreiheit prüfen." vertex="1">
          <mxGeometry height="125" width="440" x="675" y="125" as="geometry" />
        </mxCell>
        <mxCell id="rear-note2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Switch hinten HE 8, mitgelieferte Blindplatte vorn: IEC-Stromanschluss zeigt nach innen. Aus 260 mm Rack-Außentiefe minus 150 mm Switch-Tiefe folgt höchstens 110 mm für Schienen und Stecker; nutzbarer Kabelraum unbekannt. Gegebenenfalls gewinkeltes IEC-Kabel." vertex="1">
          <mxGeometry height="135" width="440" x="675" y="275" as="geometry" />
        </mxCell>
        <mxCell id="rear-note3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Leisten HE 6/5 sind vorläufig: Vorn sitzen auf HE 6 der Pi-Halter und auf HE 5 der kurze Green-Boden; die Schublade belegt HE 1–2. Abstand, Stecker und Netzteile prüfen; Leisten bei Bedarf versetzen. Beide separat speisen, nicht ineinanderstecken. Strom links, Netzwerk rechts bündeln." vertex="1">
          <mxGeometry height="125" width="440" x="675" y="435" as="geometry" />
        </mxCell>
        <mxCell id="rear-note4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#999999;" value="Ethernet zum Switch HE 8 (vorläufig): 1 × 1 m für Green HE 5; 2 × 1 m für Pi 4/5 HE 6; 2 × 1 m für Hue/Bosch HE 4; 2 × 1,5 m für Hue/Sonos HE 3. Dazu 1 Uplink mit separat zu messender Länge: 8 Ports belegt. Flexible Cat6-Kabel seitlich führen, beide Enden beschriften; Längen am Rack prüfen." vertex="1">
          <mxGeometry height="145" width="440" x="675" y="585" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17"><diagram name="10-Zoll-Rack – Vorentwurf" id="rack-v1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="10″-Rack – vorläufige Platzplanung" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=15;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="760" height="40" /></mxCell><mxCell id="subtitle" value="Nur Smart-Home-Geräte: ein 8-Port-Switch, Uplink zum bestehenden Netz; Stromverteilung hinten/oben" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=15;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="60" width="1040" height="30" /></mxCell><mxCell id="u0" value="HE 8" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#d9eaf7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="120" width="75" height="58" /></mxCell><mxCell id="gear0" value="DIGITUS · 10″ · 1 HE · 8 × 1 Gbit/s · unmanaged" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#d9eaf7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="120" width="423" height="58" /></mxCell><mxCell id="u1" value="HE 7" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="185" width="75" height="58" /></mxCell><mxCell id="gear1" value="Reserve / Kabelführung" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="185" width="423" height="58" /></mxCell><mxCell id="u2" value="HE 6" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1f2df;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="250" width="75" height="58" /></mxCell><mxCell id="gear2" value="A · 3 Hue Bridges · Geräte" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1f2df;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="250" width="423" height="58" /></mxCell><mxCell id="u3" value="HE 5" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1f2df;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="315" width="75" height="58" /></mxCell><mxCell id="gear3" value="A · Fachboden und Freiraum" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1f2df;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="315" width="423" height="58" /></mxCell><mxCell id="u4" value="HE 4" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1f2df;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="380" width="75" height="58" /></mxCell><mxCell id="gear4" value="B · Bosch + TaHoma Switch · Geräte" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1f2df;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="380" width="423" height="58" /></mxCell><mxCell id="u5" value="HE 3" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1f2df;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="445" width="75" height="58" /></mxCell><mxCell id="gear5" value="B · Fachboden und Freiraum" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1f2df;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="445" width="423" height="58" /></mxCell><mxCell id="u6" value="HE 2" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1f2df;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="510" width="75" height="58" /></mxCell><mxCell id="gear6" value="C · Sonos Boost · Gerät" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1f2df;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="510" width="423" height="58" /></mxCell><mxCell id="u7" value="HE 1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1f2df;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="575" width="75" height="58" /></mxCell><mxCell id="gear7" value="C · Fachboden und Freiraum" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1f2df;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="575" width="423" height="58" /></mxCell><mxCell id="note1" value="8 HE konservativ geplant: 1 HE Switch + 3 × 2 HE für Fachböden und Geräte + 1 HE Reserve. Netzteile und Stecker hinten/oben noch prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="128" width="500" height="100" /></mxCell><mxCell id="note2" value="6 HE sind mit drei Fachböden nicht verlässlich. Nur mit gemessenen Geräten und kompakterer Montage erneut prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="248" width="500" height="115" /></mxCell><mxCell id="note3" value="Die Referenz zeigt das Montageprinzip, nicht die Passform deiner Geräte. Fachböden, Steckernetzteile, Funksignal und Kabel brauchen eine maßstäbliche Draufsicht bzw. einen Aufbaucheck." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="383" width="500" height="130" /></mxCell><mxCell id="note4" value="Portbedarf: 3 × Hue + Bosch + Sonos + Uplink = 6. TaHoma per WLAN; mit optionalem Ethernet-Adapter = 7. Ein 8-Port-Switch reicht damit." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="533" width="500" height="87" /></mxCell></root></mxGraphModel></diagram><diagram name="Fachböden – Stellflächen" id="shelves-v1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title2" value="Draufsicht – Stellflächen, ca. 1 px/mm" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=23;fillColor=#ffffff;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="640" height="42" /></mxCell><mxCell id="labelA" value="A · 3 Hue Bridges" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#ffffff;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="80" width="245" height="40" /></mxCell><mxCell id="shelfA" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="130" width="212" height="260" /></mxCell><mxCell id="hue1" value="Hue 88 × 88" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=12;fillColor=#e1f2df;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="138" width="88" height="88" /></mxCell><mxCell id="hue2" value="Hue 88 × 88" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=12;fillColor=#e1f2df;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry as="geometry" x="154" y="138" width="88" height="88" /></mxCell><mxCell id="hue3" value="Hue 88 × 88" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=12;fillColor=#e1f2df;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="236" width="88" height="88" /></mxCell><mxCell id="labelB" value="B · Bosch + TaHoma" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#ffffff;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="80" width="265" height="40" /></mxCell><mxCell id="shelfB" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="130" width="212" height="260" /></mxCell><mxCell id="bosch" value="Bosch I?&#10;120 × 135" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry as="geometry" x="335" y="138" width="120" height="135" /></mxCell><mxCell id="tahoma" value="TaHoma Switch&#10;1870595&#10;67 × 162 mm" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="138" width="68" height="162" /></mxCell><mxCell id="labelC" value="C · Sonos Boost" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#ffffff;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry as="geometry" x="615" y="80" width="225" height="40" /></mxCell><mxCell id="shelfC" value="Sonos Boost&#10;115 × 115 mm" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#e1f2df;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry as="geometry" x="615" y="130" width="175" height="110" /></mxCell><mxCell id="noteA" value="Der DIGITUS-Switch sitzt an den Frontschienen und braucht keine Stellfläche. Bosch-Modell, Kabel und Stromanschlüsse bleiben zu prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="435" width="750" height="95" /></mxCell><mxCell id="noteB" value="Die Stromleiste aus deinem Beispiel sitzt hinten/oben. Sie belegt keine eigene HE an der Front, braucht aber Tiefe und Platz für Netzteile." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="550" width="750" height="90" /></mxCell></root></mxGraphModel></diagram><diagram name="Keller – DSIT 12 HE" id="basement-v1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="basement-title" value="Keller · vorhandener DSIT 10″-Schrank · 12 HE" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=23;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="760" height="45" /></mxCell><mxCell id="basement-u-12" value="HE 12" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#d9eaf7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="90" width="75" height="42" /></mxCell><mxCell id="basement-gear-12" value="TP-Link TL-SG108PE · 8 Ports · 4 × PoE+ · vorhandener 10″-Einbaurahmen" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#d9eaf7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="90" width="480" height="42" /></mxCell><mxCell id="basement-u-11" value="HE 11" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="138" width="75" height="42" /></mxCell><mxCell id="basement-gear-11" value="frei / noch nicht geplant" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="138" width="480" height="42" /></mxCell><mxCell id="basement-u-10" value="HE 10" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="186" width="75" height="42" /></mxCell><mxCell id="basement-gear-10" value="frei / noch nicht geplant" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="186" width="480" height="42" /></mxCell><mxCell id="basement-u-9" value="HE 9" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="234" width="75" height="42" /></mxCell><mxCell id="basement-gear-9" value="frei / noch nicht geplant" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="234" width="480" height="42" /></mxCell><mxCell id="basement-u-8" value="HE 8" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="282" width="75" height="42" /></mxCell><mxCell id="basement-gear-8" value="frei / noch nicht geplant" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="282" width="480" height="42" /></mxCell><mxCell id="basement-u-7" value="HE 7" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="330" width="75" height="42" /></mxCell><mxCell id="basement-gear-7" value="frei / noch nicht geplant" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="330" width="480" height="42" /></mxCell><mxCell id="basement-u-6" value="HE 6" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="378" width="75" height="42" /></mxCell><mxCell id="basement-gear-6" value="frei / noch nicht geplant" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="378" width="480" height="42" /></mxCell><mxCell id="basement-u-5" value="HE 5" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="426" width="75" height="42" /></mxCell><mxCell id="basement-gear-5" value="frei / noch nicht geplant" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="426" width="480" height="42" /></mxCell><mxCell id="basement-u-4" value="HE 4" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="474" width="75" height="42" /></mxCell><mxCell id="basement-gear-4" value="frei / noch nicht geplant" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="474" width="480" height="42" /></mxCell><mxCell id="basement-u-3" value="HE 3" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="522" width="75" height="42" /></mxCell><mxCell id="basement-gear-3" value="frei / noch nicht geplant" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="522" width="480" height="42" /></mxCell><mxCell id="basement-u-2" value="HE 2" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="570" width="75" height="42" /></mxCell><mxCell id="basement-gear-2" value="frei / noch nicht geplant" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="570" width="480" height="42" /></mxCell><mxCell id="basement-u-1" value="HE 1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="618" width="75" height="42" /></mxCell><mxCell id="basement-gear-1" value="frei / noch nicht geplant" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="618" width="480" height="42" /></mxCell><mxCell id="basement-note-1" value="Der TL-SG108PE ist ein Desktop-Switch (ca. 158 × 101 × 25 mm). Einbaurahmen vorhanden; Passform, Befestigung und Netzteilplatz vor Einbau prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#fff2cc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="640" y="130" width="450" height="125" /></mxCell><mxCell id="basement-note-2" value="PoE-Leistungsbudget hängt von der Hardwareversion ab. Die angeschlossenen PoE-Geräte sind noch nicht geplant." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#dae8fc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="640" y="285" width="450" height="95" /></mxCell><mxCell id="basement-note-3" value="Darstellung: nur bekannte Belegung. Weitere Geräte und Kabelführung im Keller-Schrank noch offen." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1d5e7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="640" y="410" width="450" height="95" /></mxCell></root></mxGraphModel></diagram></mxfile>
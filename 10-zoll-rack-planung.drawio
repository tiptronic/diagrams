        <mxCell id="basement-note-1" value="Der TL-SG108PE ist ein Desktop-Switch (ca. 158 × 101 × 25 mm). Einbaurahmen vorhanden; Passform, Befestigung und Netzteilplatz vor Einbau prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#fff2cc;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="130" width="450" height="125" />
        </mxCell>
        <mxCell id="basement-note-2" value="PoE-Leistungsbudget hängt von der Hardwareversion ab. Die angeschlossenen PoE-Geräte sind noch nicht geplant." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#dae8fc;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="285" width="450" height="95" />
        </mxCell>
        <mxCell id="basement-note-3" value="Darstellung: nur bekannte Belegung. Weitere Geräte und Kabelführung im Keller-Schrank noch offen." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1d5e7;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="410" width="450" height="95" />

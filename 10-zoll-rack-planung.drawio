          <mxGeometry as="geometry" x="40" y="455" width="900" height="75" />
        </mxCell>
        <mxCell id="sh-note2" value="B: Bosch-Abmessung gilt nur für Controller I; das genaue Gerät bleibt zu prüfen. Die TaHoma liegt flach. Steckplätze und Kabelrichtung beim Aufbau prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="545" width="900" height="80" />
        </mxCell>
        <mxCell id="sh-note3" value="Die zwei Steckdosenleisten sitzen oben hinten an den Rückschienen. Der Raum hinter den Böden dient der Kabelführung, nicht als durchgehend freie Geräteebene." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="645" width="900" height="70" />

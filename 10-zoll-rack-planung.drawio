        </mxCell>
        <mxCell id="c-label" value="C · HE 7 · TaHoma quer auf 150 mm?" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="405" width="450" height="35" />
        </mxCell>
        <mxCell id="c-shelf" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="445" width="212" height="150" />
        </mxCell>
        <mxCell id="c-tahoma" value="TaHoma&#10;162 × 67" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="455" width="162" height="67" />
        </mxCell>
        <mxCell id="sh-note1" value="A/B: Diese beiden Kombinationen hast du auf vorhandenen 150-mm-Böden nebeneinander ausprobiert. Bei Hue + Sonos ist seitlich wenig Abstand; Stecker und Kabel im Rack prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="520" y="405" width="560" height="95" />
        </mxCell>
        <mxCell id="sh-note2" value="C ist ein Vorschlag: TaHoma mit 162 mm quer, 67 mm in die Tiefe. Gerät, Netzteil und Montagehöhe auf einem dritten Boden im T1 Plus noch nicht erprobt." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="520" y="515" width="560" height="95" />
        </mxCell>
        <mxCell id="sh-note3" value="Die Zeichnung zeigt nur Stellflächen. Für HE 7 zusätzlich vertikalen Platz sowie Abstand zur rückseitigen PDU 2 prüfen. 200-/230-mm-Böden sind in diesem Entwurf nicht mehr eingeplant." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="635" width="1040" height="75" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

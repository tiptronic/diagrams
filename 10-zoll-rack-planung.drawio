          <mxGeometry as="geometry" x="42" y="380" width="75" height="58" />
        </mxCell>
        <mxCell id="gear4" value="B · Hue Bridge + Bosch Controller&#10;auf 150-mm-Fachboden · 1 HE (Stellprobe)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1f2df;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="117" y="380" width="423" height="58" />
        </mxCell>
        <mxCell id="u5" value="HE 3" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#ffe6cc;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="445" width="75" height="58" />
        </mxCell>
        <mxCell id="u6" value="HE 2" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#dae8fc;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="510" width="75" height="58" />
        </mxCell>
        <mxCell id="gear6" value="A · Hue Bridge + Sonos Boost&#10;auf 150-mm-Fachboden · 1 HE (Stellprobe)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#ffe6cc;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="117" y="445" width="423" height="58" />
        </mxCell>
        <mxCell id="drawer" value="2-HE-Schublade · abschließbar" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#dae8fc;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="117" y="510" width="423" height="123" />
        </mxCell>
        <mxCell id="u7" value="HE 1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#dae8fc;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="575" width="75" height="58" />
        </mxCell>
        <mxCell id="note1" value="Front: HE 8 Blindplatte (Switch hinten); HE 7 frei für Luft; HE 6 zwei Pis auf DP-0033; HE 5 Green auf Boden C (1 HE); HE 4 Hue/Bosch auf Boden B (1 HE); HE 3 Hue/Sonos auf Boden A (1 HE); HE 2–1 Schublade. Hinten: Switch HE 8 und zwei 4-fach-Leisten HE 6/5." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="128" width="500" height="100" />
        </mxCell>
        <mxCell id="note2" value="A/B: Stellfläche und Einbauhöhe für je 1 HE laut deiner Stellprobe verifiziert. C: Green allein auf 150-mm-Boden auf HE 5. Ein Boden auf HE 8 würde den rückseitigen 150-mm-Switch bei 260 mm Racktiefe überlappen; innen bleibt zudem Platz für den IEC-Stecker nötig." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="248" width="500" height="130" />
        </mxCell>
        <mxCell id="note3" value="Bosch Controller: 100 × 100 × 29 mm laut deiner Angabe. TaHoma ist vorerst außerhalb des Racks geplant, eventuell im EG. Netzteile, Kabelwege und Funkabstand bei der Montage prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="383" width="500" height="130" />
        </mxCell>
        <mxCell id="note4" value="Portbedarf: 2 × Hue + Bosch + Sonos + Green + Pi 4 + Pi 5 + Uplink = 8 Ports. Der vorhandene 8-Port-Switch ist damit voll. Strom: mit einzelnen Netzteilen 8 Schuko-Anschlüsse einschließlich Switch; Netzteilbreite an den zwei 4-fach-Leisten prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="533" width="500" height="105" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

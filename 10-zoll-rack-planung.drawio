        </mxCell>
        <mxCell id="b-rear" value="ca. 110 mm hinter Boden B" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="520" y="310" width="430" height="35" />
        </mxCell>
        <mxCell id="c-label" value="C · HE 5 · Green auf 150 mm" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="405" width="450" height="35" />
        </mxCell>
        <mxCell id="c-shelf" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="445" width="212" height="150" />
        </mxCell>
        <mxCell id="c-green" value="Home Assistant Green&#10;112 × 112" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="115" y="464" width="112" height="112" />
        </mxCell>
        <mxCell id="sh-note1" value="A/B: Diese beiden Kombinationen hast du auf vorhandenen 150-mm-Böden nebeneinander ausprobiert. Bei Hue + Sonos ist seitlich wenig Abstand; Stecker und Kabel im Rack prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="520" y="405" width="560" height="95" />
        </mxCell>
        <mxCell id="sh-note2" value="C: Home Assistant Green 112 × 112 × 32 mm steht allein auf dem 150-mm-Boden. Netzteil und Ethernet-Kabel hinter dem Gerät führen. TaHoma ist vorerst außerhalb des Racks geplant, eventuell im EG." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="520" y="515" width="560" height="95" />
        </mxCell>
        <mxCell id="sh-note3" value="Die Paarungen A und B sind durch deine Probe bestätigt. Im Rack noch Pi-Kühler auf HE 6, Green auf HE 5 und den Abstand zur rückseitigen Leiste auf HE 5 prüfen. Die Leisten können bei Bedarf versetzt werden." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="635" width="1040" height="75" />
        </mxCell>
        <mxCell id="d-label" value="D · HE 6 · Pi 4 + Pi 5 auf DP-0033 (1 HE)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="735" width="450" height="35" />
        </mxCell>
        <mxCell id="d-shelf" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="780" width="216" height="100" />
        </mxCell>
        <mxCell id="d-pi1" value="Pi 4" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="76" y="796" width="85" height="56" />
        </mxCell>
        <mxCell id="d-pi2" value="Pi 5" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="185" y="796" width="85" height="56" />
        </mxCell>
        <mxCell id="d-note" value="DP-0033: Stellfläche 216 × 100 mm für Pi 4 und Pi 5. HE 7 darüber bleibt für Luft frei; kurzer Kabelweg zum Monitor oben. Optional 2,5″-SSD an der Unterseite, per USB 3.0 angeschlossen. Kühler, SSD, Steckerhöhe und Abstand zur rückseitigen Leiste auf HE 6 vor Montage prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=2;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="520" y="765" width="560" height="115" />
        </mxCell>

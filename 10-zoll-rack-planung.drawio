        </mxCell>
        <mxCell id="basement-note-2" value="PoE-Leistungsbudget hängt von der Hardwareversion ab. Die angeschlossenen PoE-Geräte sind noch nicht geplant." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#dae8fc;strokeColor=#555555;" vertex="1" parent="1">

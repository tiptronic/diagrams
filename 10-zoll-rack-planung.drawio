          <mxGeometry as="geometry" x="42" y="510" width="75" height="58" />
        </mxCell>
        <mxCell id="gear6" value="D · Raspberry Pi 4 + Pi 5 auf DeskPi DP-0033 (1 HE)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1d5e7;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="117" y="510" width="423" height="58" />
        </mxCell>
        <mxCell id="u7" value="HE 1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#e1d5e7;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="575" width="75" height="58" />
        </mxCell>
        <mxCell id="gear7" value="HE 1 frei · Luft und Zugang zu Pi-Kabeln" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="117" y="575" width="423" height="58" />
        </mxCell>
        <mxCell id="note1" value="Front: HE 8 Blindplatte (Switch hinten); HE 7 TaHoma/Green auf Boden C; HE 6–5 Hue/Bosch auf Boden A; HE 4–3 Hue/Sonos auf Boden B; HE 2 zwei Pis auf DP-0033; HE 1 Luft und Kabelzugang. Hinten: Switch HE 8 und zwei 4-fach-Leisten HE 6/5." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="128" width="500" height="100" />
        </mxCell>
        <mxCell id="note2" value="A/B/C: Gerätepaarungen passen laut deiner Stellprobe auf 150-mm-Böden. TaHoma auf HE 8 wäre nur mit kurzem Halter denkbar: Ein 150-mm-Boden überlappt den 150-mm-Switch bei 260 mm Racktiefe. Außerdem braucht der IEC-Stecker innen Platz." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="248" width="500" height="130" />
        </mxCell>
        <mxCell id="note3" value="Bosch Controller: 100 × 100 × 29 mm laut deiner Angabe. TaHoma ist über ihren Ethernet-Adapter verkabelt. Adapter, Netzteile und Funkabstand bei der Montage prüfen." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="383" width="500" height="130" />
        </mxCell>
        <mxCell id="note4" value="Portbedarf: 2 × Hue + Bosch + Sonos + Green + TaHoma-Adapter + Pi 4 + Pi 5 + Uplink = 9 Ports. Daher 16-Port-Switch einplanen. Strom: Pi 4 braucht 5 V/3 A, Pi 5 empfohlen 5 V/5 A, beide per USB-C. Mit Einzelnetzteilen: 9 Schuko-Anschlüsse; die bisherigen 8 Dosen reichen nicht." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;align=left;spacing=14;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="533" width="500" height="105" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
